<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    style="@style/base_layout_style"
    android:paddingLeft="0dp"
    android:paddingRight="0dp"
    android:orientation="vertical">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="95"
        android:gravity="center|bottom"
        android:orientation="vertical" >

        <ListView
            android:id="@+id/tagBarInventoryinventoryRfidList1"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="95"
            android:divider="@android:color/darker_gray"
            android:dividerHeight="0.25dp" />

        <TextView
            android:id="@+id/tagBarInventoryRfidEmpty1"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="95"
            android:padding="@dimen/default_padding"
            style="@style/style_medium_font"
            android:text="@string/notag_found" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/tagBarInventoryRfidRunTime1"
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_height="wrap_content"
                android:textAlignment="textStart" />

            <TextView
                android:id="@+id/tagBarInventoryRfidFilterOn1"
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_height="wrap_content"
                android:visibility="visible"
                android:textColor="#ff0000"
                android:text="Filter On" />
        </LinearLayout>
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="50dp"
        android:gravity="center|bottom"
        android:orientation="horizontal" >

        <TextView
            android:id="@+id/tagBarInventoryRfidYield1"
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:gravity="center"
            style="@style/style_button_font" />

        <Button
            android:id="@+id/tagBarInventoryRfidButton1"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="match_parent"
            style="@style/style_button_font"
            android:text="@string/start_title" />

        <TextView
            android:id="@+id/tagBarInventoryRfidRate1"
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:gravity="center"
            style="@style/style_button_font" />
    </LinearLayout>
</LinearLayout>